      "titleFontSizeMedium": "17px",
      "titleFontSizeSmall": "16px",
      "borderColor": "rgba(0, 0, 0, 0)",
      "titleFontWeight": "600"
    },
    "DataTable": {
      "thPaddingSmall": "12px 14px",
      "tdPaddingSmall": "12px 14px",
      "thPaddingMedium": "14px 16px",
      "tdPaddingMedium": "16px",
      "thPaddingLarge": "18px 20px",
      "tdPaddingLarge": "18px 20px",
      "thFontWeight": "600",
      "borderRadius": "10px"
    },
