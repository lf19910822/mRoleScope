{
  "$schema": "./theme.schema.json",
  "id": "ocean-breeze",
  "name": "Ocean Breeze",
  "author": "naiveuithemes",
  "description": "Sky blue with a neighboring cyan accent, filled inputs and generous rounded corners.",
  "category": "soft",
  "tags": [
    "blue",
    "cyan",
    "rounded"
  ],
  "light": {
    "Button": {
      "fontWeight": "600",
      "paddingMedium": "0 20px",
      "paddingSmall": "0 10px",
      "paddingLarge": "0 24px",
      "borderRadiusTiny": "6px",
      "borderRadiusSmall": "6px",
      "borderRadiusMedium": "10px",
      "borderRadiusLarge": "10px",
      "border": "1px solid #d1dbe1"
    },
    "Input": {
      "borderRadius": "10px",
      "paddingMedium": "0 14px",
      "color": "#f0f8fd",
      "colorFocus": "#ffffff",
      "border": "1px solid transparent",
      "borderHover": "1px solid transparent",
      "borderFocus": "1px solid #007bab",
      "boxShadowFocus": "0 0 0 2px rgba(0, 123, 171, 0.2)"
    },
    "InternalSelection": {
      "borderRadius": "10px",
      "color": "#f0f8fd",
      "colorActive": "#ffffff",
