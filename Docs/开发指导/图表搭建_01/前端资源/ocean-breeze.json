      "borderHover": "1px solid transparent",
      "borderActive": "1px solid #007bab",
      "borderFocus": "1px solid #007bab",
      "boxShadowActive": "0 0 0 2px rgba(0, 123, 171, 0.2)",
      "boxShadowFocus": "0 0 0 2px rgba(0, 123, 171, 0.2)"
    },
    "Card": {
