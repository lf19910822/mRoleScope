# The Web Edge deliberately has no runtime API, database, credential, or
# domain material baked in. It only receives compiled Vue assets and a small
# Nginx configuration rendered from root-owned runtime values at startup.
FROM node:20.20.2-alpine@sha256:afdf98210b07b586eb71fa22ba2e432e058e4cd1304d31ed60888755b8c865fb AS build
WORKDIR /src/web

COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM nginx:1.27.4-alpine@sha256:a71e0884a7f1192ecf5decf062b67d46b54ad63f0cc1b8aa7e705f739a97c2fc

COPY --from=build /src/web/dist /usr/share/nginx/html
COPY docker/web-edge/nginx.conf.template /etc/nginx/nginx.conf.template
COPY docker/web-edge/entrypoint.sh /usr/local/bin/mrolescope-web-edge-entrypoint

RUN chmod 0555 /usr/local/bin/mrolescope-web-edge-entrypoint \
    && rm -f /etc/nginx/conf.d/default.conf

EXPOSE 80 443
ENTRYPOINT ["/usr/local/bin/mrolescope-web-edge-entrypoint"]
