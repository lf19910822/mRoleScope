user nginx;
worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format mrolescope '$remote_addr [$time_iso8601] "$request" $status $request_time';
    access_log /dev/stdout mrolescope;
    sendfile on;
    server_tokens off;

    limit_req_zone $binary_remote_addr zone=mrolescope_verify:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=mrolescope_api:10m rate=10r/s;
    limit_req_status 429;

    server {
        listen 80 default_server;
        server_name _;
        return 444;
    }

    server {
        listen 80;
        server_name ${MROLESCOPE_WEB_HOSTNAME};

        location ^~ /.well-known/acme-challenge/ {
            root /usr/share/nginx/acme-challenge;
            default_type text/plain;
            try_files $uri =404;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
    }

    server {
        listen 443 ssl;
        server_name ${MROLESCOPE_WEB_HOSTNAME};

        ssl_certificate /etc/nginx/tls/fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 10m;

        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;

        location = /access {
            default_type text/html;
            alias /usr/share/nginx/html/access/index.html;
        }

        location = /access/ {
            return 301 /access;
        }

        location = /access/access.css {
            default_type text/css;
            alias /usr/share/nginx/html/access/access.css;
        }

        location = /access/access.js {
            default_type application/javascript;
            alias /usr/share/nginx/html/access/access.js;
        }

        location = /api/v1/access/verify {
            limit_req zone=mrolescope_verify burst=2 nodelay;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_pass http://api:8080;
        }

        location = /api/v1/access/check {
            internal;
            proxy_pass http://api:8080/api/v1/access/check;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location = /_mrolescope_auth {
            internal;
            proxy_pass http://api:8080/api/v1/access/check;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location ^~ /api/ {
            limit_req zone=mrolescope_api burst=20 nodelay;
            auth_request /_mrolescope_auth;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Cookie $http_cookie;
            proxy_pass http://api:8080;
        }

        location / {
            auth_request /_mrolescope_auth;
            error_page 401 = @mrolescope_access_redirect;
            root /usr/share/nginx/html;
            try_files $uri $uri/ /index.html;
        }

        location @mrolescope_access_redirect {
            return 302 /access;
        }
    }
}
