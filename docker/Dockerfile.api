FROM golang:1.22.5-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/mrolescope-api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/mrolescope-api /mrolescope-api
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/mrolescope-api"]
