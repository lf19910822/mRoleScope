# Go API / worker
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://mrolescope:mrolescope@localhost:5432/mrolescope?sslmode=disable
COLLECTOR_PYTHON=python3
COLLECTOR_SCRIPT=collector/mihoyo_collector.py
COLLECTOR_TIMEOUT=15m
ARCHIVE_LOCAL_DIR=./var/archives

# PostgreSQL container (local development only)
POSTGRES_DB=mrolescope
POSTGRES_USER=mrolescope
POSTGRES_PASSWORD=change-me-before-any-shared-environment
