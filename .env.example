# Go API / worker
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://mrolescope:mrolescope@localhost:5432/mrolescope?sslmode=disable
COLLECTOR_PYTHON=python3
COLLECTOR_SCRIPT=collector/mihoyo_collector.py
COLLECTOR_TIMEOUT=15m
SYNC_TIMEOUT=45m
SYNC_RETRY_DELAYS=15m,45m
SYNC_TEMP_ROOT=/run/mrolescope-sync

# Tencent COS (worker only; store real values only in CVM's root-owned secret file)
COS_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
COS_REGION=ap-shanghai
COS_BUCKET=replace-with-private-bucket-appid
COS_PREFIX=mrolescope
COS_ACCESS_KEY_ID=replace-with-runtime-identity
COS_SECRET_ACCESS_KEY=replace-with-runtime-secret

# PostgreSQL container (local development only)
POSTGRES_DB=mrolescope
POSTGRES_USER=mrolescope
POSTGRES_PASSWORD=change-me-before-any-shared-environment
