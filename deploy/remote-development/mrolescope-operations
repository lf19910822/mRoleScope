#!/usr/bin/env bash
# Root-owned operations entry point for the remote-development GitHub Actions
# runner. It deliberately accepts only a small, fixed vocabulary and never
# accepts a shell fragment, image name, Compose path, environment file, or
# systemd unit from the caller.

set -euo pipefail

readonly SYNC_HELPER='/usr/local/sbin/mrolescope-sync'
readonly ANALYSIS_HELPER='/usr/local/sbin/mrolescope-analysis'
readonly BACKFILL_HELPER='/usr/local/sbin/mrolescope-backfill-versioned-content'
readonly DICTIONARY_HELPER='/usr/local/sbin/mrolescope-dictionary'
readonly SYNC_SERVICE='mrolescope-sync.service'
readonly SYNC_TIMER='mrolescope-sync.timer'
readonly ANALYSIS_SERVICE='mrolescope-analysis.service'
readonly CANDIDATE_ANALYSIS_SERVICE='mrolescope-candidate-analysis.service'
readonly CANDIDATE_V02_ANALYSIS_SERVICE='mrolescope-candidate-analysis-v0.2.service'
readonly BACKFILL_SERVICE='mrolescope-backfill-versioned-content.service'
readonly RUNNER_SERVICE='actions.runner.lf19910822-mRoleScope.mrolescope-remote-development.service'
readonly SECRETS_FILE='/etc/mrolescope/secrets/remote-development.env'

PATH='/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

die() {
  printf 'mrolescope operations failed: %s\n' "$1" >&2
  exit 1
}

print_unit_state() {
  local unit="$1"
  printf '%s enabled: ' "$unit"
  systemctl is-enabled "$unit" 2>&1 || true
  printf '%s active: ' "$unit"
  systemctl is-active "$unit" 2>&1 || true
}

show_status() {
  local failed=0

  printf '%s\n' '--- system services ---'
  print_unit_state docker.service
  print_unit_state "$RUNNER_SERVICE"
  print_unit_state "$SYNC_SERVICE"
  print_unit_state "$SYNC_TIMER"
  print_unit_state "$BACKFILL_SERVICE"
  print_unit_state "$ANALYSIS_SERVICE"
  print_unit_state "$CANDIDATE_ANALYSIS_SERVICE"
  print_unit_state "$CANDIDATE_V02_ANALYSIS_SERVICE"

  printf '%s\n' '--- API health ---'
  if ! curl --fail --silent --show-error --max-time 3 http://127.0.0.1:8080/healthz; then
    failed=1
  fi
  printf '\n'
  if ! curl --fail --silent --show-error --max-time 3 http://127.0.0.1:8080/readyz; then
    failed=1
  fi
  printf '\n'

  printf '%s\n' '--- containers ---'
  docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'

  printf '%s\n' '--- next synchronization ---'
  systemctl list-timers "$SYNC_TIMER" --all --no-pager

  return "$failed"
}

[[ "${EUID}" -eq 0 ]] || die 'must be invoked through sudo'
if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != 'mrolescope-deploy' ]]; then
  die 'only the mrolescope-deploy service account may invoke this through sudo'
fi
[[ "$#" -ge 1 && "$#" -le 3 ]] || die 'invalid operation arguments'

case "$1" in
  status)
    [[ "$#" -eq 1 ]] || die 'status accepts no arguments'
    show_status
    ;;
  initialize-sync)
    [[ "$#" -eq 1 ]] || die 'initialize-sync accepts no arguments'
    [[ -x "$SYNC_HELPER" ]] || die 'synchronization helper is not installed'
    if systemctl is-active --quiet "$SYNC_TIMER"; then
      die 'disable the daily timer before requesting initialization synchronization'
    fi
    exec "$SYNC_HELPER" initialize
    ;;
  enable-sync-timer)
    [[ "$#" -eq 1 ]] || die 'enable-sync-timer accepts no arguments'
    [[ -x "$SYNC_HELPER" ]] || die 'synchronization helper is not installed'
    [[ -f "$SECRETS_FILE" ]] || die 'runtime secret file is not installed'
    systemctl enable --now "$SYNC_TIMER"
    systemctl is-active --quiet "$SYNC_TIMER" || die 'daily timer did not become active'
    systemctl list-timers "$SYNC_TIMER" --all --no-pager
    ;;
  disable-sync-timer)
    [[ "$#" -eq 1 ]] || die 'disable-sync-timer accepts no arguments'
    # This prevents future starts. It deliberately does not interrupt a
    # currently running one-shot synchronization, which could leave an
    # upstream request or object upload half complete.
    systemctl disable --now "$SYNC_TIMER"
    ;;
  backfill-versioned-content)
    [[ "$#" -eq 1 ]] || die 'backfill-versioned-content accepts no arguments'
    [[ -x "$BACKFILL_HELPER" ]] || die 'versioned-content backfill helper is not installed'
    [[ -f "$SECRETS_FILE" ]] || die 'runtime secret file is not installed'
    systemctl start --wait "$BACKFILL_SERVICE"
    ;;
  run-pending-analysis)
    [[ "$#" -eq 1 ]] || die 'run-pending-analysis accepts no arguments'
    [[ -x "$ANALYSIS_HELPER" ]] || die 'analysis helper is not installed'
    [[ -f "$SECRETS_FILE" ]] || die 'runtime secret file is not installed'
    systemctl start --wait "$ANALYSIS_SERVICE"
    ;;
  seed-v0.1-dictionary)
    [[ "$#" -eq 2 ]] || die 'seed-v0.1-dictionary requires the authenticated operator'
    [[ -x "$DICTIONARY_HELPER" ]] || die 'dictionary helper is not installed'
    exec "$DICTIONARY_HELPER" seed-v0.1 "$2"
    ;;
  approve-v0.1-rule)
    [[ "$#" -eq 3 ]] || die 'approve-v0.1-rule requires a rule key and the authenticated operator'
    [[ -x "$DICTIONARY_HELPER" ]] || die 'dictionary helper is not installed'
    exec "$DICTIONARY_HELPER" approve-v0.1-rule "$2" "$3"
    ;;
  prepare-v0.1-analysis)
    [[ "$#" -eq 2 ]] || die 'prepare-v0.1-analysis requires the authenticated operator'
    [[ -x "$DICTIONARY_HELPER" ]] || die 'dictionary helper is not installed'
    exec "$DICTIONARY_HELPER" prepare-v0.1-analysis "$2"
    ;;
  seed-v0.2-dictionary)
    [[ "$#" -eq 2 ]] || die 'seed-v0.2-dictionary requires the authenticated operator'
    [[ -x "$DICTIONARY_HELPER" ]] || die 'dictionary helper is not installed'
    exec "$DICTIONARY_HELPER" seed-v0.2 "$2"
    ;;
  approve-v0.2-rule)
    [[ "$#" -eq 3 ]] || die 'approve-v0.2-rule requires a rule key and the authenticated operator'
    [[ -x "$DICTIONARY_HELPER" ]] || die 'dictionary helper is not installed'
    exec "$DICTIONARY_HELPER" approve-v0.2-rule "$2" "$3"
    ;;
  prepare-v0.2-analysis)
    [[ "$#" -eq 2 ]] || die 'prepare-v0.2-analysis requires the authenticated operator'
    [[ -x "$DICTIONARY_HELPER" ]] || die 'dictionary helper is not installed'
    exec "$DICTIONARY_HELPER" prepare-v0.2-analysis "$2"
    ;;
  run-v0.1-candidate-analysis)
    [[ "$#" -eq 1 ]] || die 'run-v0.1-candidate-analysis accepts no arguments'
    [[ -x "$ANALYSIS_HELPER" ]] || die 'analysis helper is not installed'
    [[ -f "$SECRETS_FILE" ]] || die 'runtime secret file is not installed'
    systemctl start --wait "$CANDIDATE_ANALYSIS_SERVICE"
    ;;
  run-v0.2-candidate-analysis)
    [[ "$#" -eq 1 ]] || die 'run-v0.2-candidate-analysis accepts no arguments'
    [[ -x "$ANALYSIS_HELPER" ]] || die 'analysis helper is not installed'
    [[ -f "$SECRETS_FILE" ]] || die 'runtime secret file is not installed'
    systemctl start --wait "$CANDIDATE_V02_ANALYSIS_SERVICE"
    ;;
  sync-logs)
    [[ "$#" -eq 1 ]] || die 'sync-logs accepts no arguments'
    journalctl --unit "$SYNC_SERVICE" --since today --no-pager
    ;;
  *)
    die 'operation is not allowlisted'
    ;;
esac
