#!/usr/bin/env bash
# Root-owned deployment entry point for the loopback-only test API. It accepts
# one immutable API digest and never operates the formal Compose project.

set -euo pipefail

readonly COMPOSE_FILE='/opt/mrolescope/remote-test-api.compose.yaml'
readonly SECRETS_FILE='/etc/mrolescope/secrets/remote-development.env'
readonly DEPLOY_CONFIG_FILE='/etc/mrolescope/remote-development.conf'
readonly RELEASE_DIR='/var/lib/mrolescope/test-api-releases'
readonly LOCK_FILE='/var/lib/mrolescope/test-api-releases/operation.lock'
readonly PROJECT_NAME='mrolescope-remote-test-api'
readonly FORMAL_BACKEND_NETWORK='mrolescope-remote-development_backend'
readonly FORMAL_EDGE_NETWORK='mrolescope-remote-development_edge'
readonly FORMAL_AI_EDGE_NETWORK='mrolescope-remote-development_ai-edge'
readonly NAMESPACE_PATTERN='^[a-z0-9][a-z0-9_-]{0,38}$'
readonly DIGEST_PATTERN='sha256:[a-f0-9]{64}'
readonly SHA_PATTERN='^[a-f0-9]{40}$'

api_image="${1:-}"
phase='preflight'
deployment_succeeded=false
deployment_config_loaded=false
api_revision=''
dockerhub_namespace=''
api_pattern=''

PATH='/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
umask 077

die() {
  printf 'mrolescope test API deployment failed during %s: %s\n' "$phase" "$1" >&2
  exit 1
}

log() {
  printf 'mrolescope test API deployment: %s\n' "$1"
}

is_root_owned_mode() {
  local path="$1" expected_mode="$2" metadata
  [[ -f "$path" && ! -L "$path" ]] || return 1
  metadata=$(stat -c '%U:%G:%a' "$path")
  [[ "$metadata" == "root:root:${expected_mode}" ]]
}

compose() {
  docker compose \
    --project-name "$PROJECT_NAME" \
    --file "$COMPOSE_FILE" \
    --env-file "$SECRETS_FILE" \
    "$@"
}

load_deployment_config() {
  local -a config_lines=()

  is_root_owned_mode "$DEPLOY_CONFIG_FILE" 644 || die 'deployment configuration must be root:root mode 0644'
  mapfile -t config_lines <"$DEPLOY_CONFIG_FILE"
  [[ "${#config_lines[@]}" -eq 1 ]] || die 'deployment configuration must contain exactly one line'
  [[ "${config_lines[0]}" == DOCKERHUB_NAMESPACE=* ]] \
    || die 'deployment configuration must define DOCKERHUB_NAMESPACE'

  dockerhub_namespace="${config_lines[0]#DOCKERHUB_NAMESPACE=}"
  [[ "$dockerhub_namespace" =~ $NAMESPACE_PATTERN ]] \
    || die 'deployment configuration has an invalid Docker Hub namespace'
  api_pattern="^docker\\.io/${dockerhub_namespace}/mrolescope-api@${DIGEST_PATTERN}$"
  deployment_config_loaded=true
}

read_current_api() {
  local current_file="$RELEASE_DIR/current.env" candidate
  [[ -f "$current_file" && ! -L "$current_file" ]] || return 0
  is_root_owned_mode "$current_file" 600 || return 0
  candidate=$(sed -nE "s|^api_image=(docker\\.io/${dockerhub_namespace}/mrolescope-api@sha256:[a-f0-9]{64})$|\\1|p" "$current_file" | tail -n 1)
  if [[ "$candidate" =~ $api_pattern ]]; then
    printf '%s' "$candidate"
  fi
}

write_record() {
  local status="$1" record_phase="$2" record_api="$3" record_revision="$4"
  local timestamp temporary record suffix

  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  temporary=$(mktemp "$RELEASE_DIR/.release.XXXXXX")
  suffix="${temporary##*.}"
  record="$RELEASE_DIR/release-${timestamp}-${status}-${suffix}.env"
  {
    printf 'status=%s\n' "$status"
    printf 'phase=%s\n' "$record_phase"
    printf 'api_image=%s\n' "$record_api"
    printf 'revision=%s\n' "$record_revision"
    printf 'recorded_at=%s\n' "$(date -u +%FT%TZ)"
  } >"$temporary"
  chmod 0600 "$temporary"
  mv -f -- "$temporary" "$record"
}

write_current() {
  local temporary
  temporary=$(mktemp "$RELEASE_DIR/.current.XXXXXX")
  {
    printf 'api_image=%s\n' "$api_image"
    printf 'revision=%s\n' "$api_revision"
    printf 'verified_at=%s\n' "$(date -u +%FT%TZ)"
  } >"$temporary"
  chmod 0600 "$temporary"
  mv -f -- "$temporary" "$RELEASE_DIR/current.env"
}

prune_records() {
  local pattern="$1" keep="$2"
  local -a records=()
  local index

  mapfile -t records < <(find "$RELEASE_DIR" -maxdepth 1 -type f -name "$pattern" -printf '%f\n' | sort -r)
  for ((index = keep; index < ${#records[@]}; index += 1)); do
    rm -f -- "$RELEASE_DIR/${records[$index]}"
  done
}

healthy_api() {
  local attempt container_id status
  for ((attempt = 1; attempt <= 20; attempt += 1)); do
    container_id=$(compose ps -q api-test)
    status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$container_id" 2>/dev/null || true)
    if [[ "$status" == healthy ]]; then
      return 0
    fi
    sleep 2
  done
  return 1
}

has_loopback_binding() {
  local container_id binding
  container_id=$(compose ps -q api-test)
  [[ -n "$container_id" ]] || return 1
  binding=$(docker inspect \
    --format '{{with index .NetworkSettings.Ports "8080/tcp"}}{{range .}}{{.HostIp}}:{{.HostPort}}{{end}}{{end}}' \
    "$container_id" 2>/dev/null || true)
  [[ "$binding" == '127.0.0.1:18080' ]]
}

rollback_api() {
  local previous_api="$1"
  if [[ -n "$previous_api" && "$previous_api" != "$api_image" ]]; then
    log 'new test API did not become healthy; restoring the previous verified test digest'
    export MROLESCOPE_TEST_API_IMAGE="$previous_api"
    compose up -d --no-deps api-test
    healthy_api
    return
  fi

  log 'new test API did not become healthy; stopping the unverified test service'
  compose stop api-test >/dev/null 2>&1 || true
  compose rm --force api-test >/dev/null 2>&1 || true
  return 1
}

check_formal_networks() {
  local network
  for network in "$FORMAL_BACKEND_NETWORK" "$FORMAL_EDGE_NETWORK" "$FORMAL_AI_EDGE_NETWORK"; do
    docker network inspect "$network" >/dev/null 2>&1 || die "required formal Docker network is unavailable: ${network}"
  done
}

cleanup() {
  local exit_code=$?
  trap - EXIT
  if [[ "$deployment_succeeded" != true && "$deployment_config_loaded" == true && "$api_image" =~ $api_pattern && -d "$RELEASE_DIR" ]]; then
    write_record failed "$phase" "$api_image" "$api_revision" || true
    prune_records 'release-*-failed-*.env' 10 || true
  fi
  exit "$exit_code"
}
trap cleanup EXIT

[[ "${EUID}" -eq 0 ]] || die 'must be invoked through sudo'
if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != 'mrolescope-deploy' ]]; then
  die 'only the mrolescope-deploy service account may invoke this through sudo'
fi
[[ "$#" -eq 1 ]] || die 'expected one API image digest'
is_root_owned_mode "$COMPOSE_FILE" 644 || die 'test Compose definition must be root:root mode 0644'
is_root_owned_mode "$SECRETS_FILE" 600 || die 'runtime secrets must be root:root mode 0600'
load_deployment_config
[[ "$api_image" =~ $api_pattern ]] || die 'API image is not an allowed immutable Docker Hub digest'
[[ -d "$RELEASE_DIR" ]] || die 'test API release directory is missing'
[[ "$(stat -c '%U:%G:%a' "$RELEASE_DIR")" == 'root:root:700' ]] || die 'test API release directory must be root:root mode 0700'
command -v docker >/dev/null 2>&1 || die 'docker is not installed'
command -v flock >/dev/null 2>&1 || die 'flock is not installed'
exec 9>"$LOCK_FILE"
flock -n 9 || die 'another test API deployment is already running'
check_formal_networks

# Source only after the fixed root-owned path and permissions are verified.
# Values are exported for Compose but never printed by this helper.
set -a
# shellcheck disable=SC1090
. "$SECRETS_FILE"
set +a
for required_value in DATABASE_URL MROLESCOPE_INVITE_BCRYPT_HASH MROLESCOPE_SESSION_SIGNING_SECRET; do
  [[ -n "${!required_value:-}" ]] || die 'required runtime configuration is missing'
done

export MROLESCOPE_TEST_API_IMAGE="$api_image"

phase='pull-image'
compose pull api-test
api_revision=$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$api_image" 2>/dev/null || true)
[[ "$api_revision" =~ $SHA_PATTERN ]] || die 'API image is missing its immutable source revision label'
previous_api=$(read_current_api || true)

phase='start-test-api'
if ! compose up -d --no-deps api-test; then
  rollback_api "$previous_api" || true
  die 'could not start the test API container'
fi

phase='verify-test-api'
if ! healthy_api; then
  rollback_api "$previous_api" || true
  die 'the new test API did not pass local health and readiness checks'
fi
if ! has_loopback_binding; then
  rollback_api "$previous_api" || true
  die 'the test API is not bound only to the fixed loopback port'
fi

phase='record-release'
write_current
write_record success "$phase" "$api_image" "$api_revision"
prune_records 'release-*-success-*.env' 10
prune_records 'release-*-failed-*.env' 10
deployment_succeeded=true
phase='complete'
log "test API deployment verified at revision ${api_revision}"
