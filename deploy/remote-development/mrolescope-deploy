#!/usr/bin/env bash
#
# Root-owned deployment entry point for the remote-development environment.
#
# Its interface is intentionally narrow: the self-hosted runner can supply
# exactly four immutable Docker Hub image digests in one configured public
# namespace. It cannot choose Compose files, secret files, image tags, ports,
# commands, or a shell to execute.

set -euo pipefail

readonly COMPOSE_FILE="/opt/mrolescope/remote-development.compose.yaml"
readonly SECRETS_FILE="/etc/mrolescope/secrets/remote-development.env"
readonly DEPLOY_CONFIG_FILE="/etc/mrolescope/remote-development.conf"
readonly RELEASE_DIR="/var/lib/mrolescope/releases"
readonly LOCK_FILE="/var/lib/mrolescope/releases/operation.lock"
readonly PROJECT_NAME="mrolescope-remote-development"
readonly NAMESPACE_PATTERN='^[a-z0-9][a-z0-9_-]{0,38}$'
readonly DIGEST_PATTERN='sha256:[a-f0-9]{64}'
readonly SHA_PATTERN='^[a-f0-9]{40}$'

PATH='/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
umask 077

api_image="${1:-}"
migrate_image="${2:-}"
worker_image="${3:-}"
web_edge_image="${4:-}"
phase="preflight"
deployment_succeeded=false
deployment_config_loaded=false
api_revision=""
dockerhub_namespace=""
api_pattern=""
migrate_pattern=""
worker_pattern=""
web_edge_pattern=""
web_edge_enabled=false
image_cleanup_enabled=true
previous_release_images=()

die() {
  printf 'mrolescope deployment failed during %s: %s\n' "$phase" "$1" >&2
  exit 1
}

log() {
  printf 'mrolescope deployment: %s\n' "$1"
}

compose() {
  docker compose \
    --project-name "$PROJECT_NAME" \
    --file "$COMPOSE_FILE" \
    --env-file "$SECRETS_FILE" \
    "$@"
}

recover_known_dirty_migration() {
  local version_output

  is_known_dirty_migration() {
    local output="$1"
    [[ "$output" == *'35 (dirty)'* || "$output" == *'Dirty database version 35'* ]]
  }

  if version_output=$(compose run --rm --no-deps migrate \
    -path=/migrations -database="$DATABASE_URL" version 2>&1); then
    if ! is_known_dirty_migration "$version_output"; then
      return 0
    fi
  elif ! is_known_dirty_migration "$version_output"; then
    die 'database migration state is dirty or unavailable; manual recovery is not allowed'
  fi

  # Release f58f270 split migration 35/36 after an earlier deployment left
  # version 35 dirty. Only that exact known failure is recoverable here: clear
  # its failed marker back to 34, then let the normal migration run apply 35
  # and 36. Any other dirty version remains a hard stop.
  log 'recovering the known dirty migration version 35 back to version 34'
  compose run --rm --no-deps migrate \
    -path=/migrations -database="$DATABASE_URL" force 34
}

is_root_owned_mode() {
  local path="$1" expected_mode="$2" metadata
  [[ -f "$path" && ! -L "$path" ]] || return 1
  metadata=$(stat -c '%U:%G:%a' "$path")
  [[ "$metadata" == "root:root:${expected_mode}" ]]
}

load_deployment_config() {
  local -a config_lines=()

  is_root_owned_mode "$DEPLOY_CONFIG_FILE" 644 || die "deployment configuration must be root:root mode 0644"
  mapfile -t config_lines <"$DEPLOY_CONFIG_FILE"
  [[ "${#config_lines[@]}" -eq 1 ]] || die "deployment configuration must contain exactly one line"
  [[ "${config_lines[0]}" == DOCKERHUB_NAMESPACE=* ]] \
    || die "deployment configuration must define DOCKERHUB_NAMESPACE"

  dockerhub_namespace="${config_lines[0]#DOCKERHUB_NAMESPACE=}"
  [[ "$dockerhub_namespace" =~ $NAMESPACE_PATTERN ]] \
    || die "deployment configuration has an invalid Docker Hub namespace"
  api_pattern="^docker\\.io/${dockerhub_namespace}/mrolescope-api@${DIGEST_PATTERN}$"
  migrate_pattern="^docker\\.io/${dockerhub_namespace}/mrolescope-migrate@${DIGEST_PATTERN}$"
  worker_pattern="^docker\\.io/${dockerhub_namespace}/mrolescope-worker@${DIGEST_PATTERN}$"
  web_edge_pattern="^docker\\.io/${dockerhub_namespace}/mrolescope-web-edge@${DIGEST_PATTERN}$"
  deployment_config_loaded=true
}

read_current_api() {
  local current_file="$RELEASE_DIR/current.env" candidate
  [[ -f "$current_file" && ! -L "$current_file" ]] || return 0
  candidate=$(sed -nE "s|^api_image=(docker\\.io/${dockerhub_namespace}/mrolescope-api@sha256:[a-f0-9]{64})$|\\1|p" "$current_file" | tail -n 1)
  if [[ -n "$candidate" && "$candidate" =~ $api_pattern ]]; then
    printf '%s' "$candidate"
  fi
}

read_current_web_edge() {
  local current_file="$RELEASE_DIR/current.env" candidate
  [[ -f "$current_file" && ! -L "$current_file" ]] || return 0
  candidate=$(sed -nE "s|^web_edge_image=(docker\\.io/${dockerhub_namespace}/mrolescope-web-edge@sha256:[a-f0-9]{64})$|\\1|p" "$current_file" | tail -n 1)
  if [[ -n "$candidate" && "$candidate" =~ $web_edge_pattern ]]; then
    printf '%s' "$candidate"
  fi
}

write_record() {
  local status="$1" record_phase="$2" record_api="$3" record_migrate="$4" record_worker="$5" record_web_edge="$6" record_revision="$7"
  local timestamp temporary record suffix

  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  temporary=$(mktemp "$RELEASE_DIR/.release.XXXXXX")
  suffix="${temporary##*.}"
  record="$RELEASE_DIR/release-${timestamp}-${status}-${suffix}.env"
  {
    printf 'status=%s\n' "$status"
    printf 'phase=%s\n' "$record_phase"
    printf 'api_image=%s\n' "$record_api"
    printf 'migrate_image=%s\n' "$record_migrate"
    printf 'worker_image=%s\n' "$record_worker"
    printf 'web_edge_image=%s\n' "$record_web_edge"
    printf 'revision=%s\n' "$record_revision"
    printf 'recorded_at=%s\n' "$(date -u +%FT%TZ)"
  } >"$temporary"
  chmod 0600 "$temporary"
  mv -f -- "$temporary" "$record"
}

write_current() {
  local temporary
  temporary=$(mktemp "$RELEASE_DIR/.current.XXXXXX")
  {
    printf 'api_image=%s\n' "$api_image"
    printf 'migrate_image=%s\n' "$migrate_image"
    printf 'worker_image=%s\n' "$worker_image"
    printf 'web_edge_image=%s\n' "$web_edge_image"
    printf 'revision=%s\n' "$api_revision"
    printf 'verified_at=%s\n' "$(date -u +%FT%TZ)"
  } >"$temporary"
  chmod 0600 "$temporary"
  mv -f -- "$temporary" "$RELEASE_DIR/current.env"
}

prune_matching_records() {
  local pattern="$1" keep="$2"
  local -a records=()
  local index
  mapfile -t records < <(find "$RELEASE_DIR" -maxdepth 1 -type f -name "$pattern" -printf '%f\n' | sort -r)
  for ((index = keep; index < ${#records[@]}; index += 1)); do
    rm -f -- "$RELEASE_DIR/${records[$index]}"
  done
}

prune_records() {
  prune_matching_records 'release-*-success-*.env' 10
  prune_matching_records 'release-*-failed-*.env' 10
}

read_release_image_set() {
  local record="$1" key candidate

  [[ -f "$record" && ! -L "$record" ]] || return 1
  is_root_owned_mode "$record" 600 || return 1

  for key in api_image migrate_image worker_image web_edge_image; do
    candidate=$(sed -nE "s|^${key}=(docker\\.io/${dockerhub_namespace}/mrolescope-[a-z-]+@sha256:[a-f0-9]{64})$|\\1|p" "$record")
    case "$key" in
      api_image)
        [[ "$candidate" =~ $api_pattern ]] || return 1
        ;;
      migrate_image)
        [[ "$candidate" =~ $migrate_pattern ]] || return 1
        ;;
      worker_image)
        [[ "$candidate" =~ $worker_pattern ]] || return 1
        ;;
      web_edge_image)
        [[ "$candidate" =~ $web_edge_pattern ]] || return 1
        ;;
    esac
    printf '%s\n' "$candidate"
  done
}

capture_previous_release_images() {
  local current_file="$RELEASE_DIR/current.env" snapshot

  if [[ ! -e "$current_file" && ! -L "$current_file" ]]; then
    return 0
  fi
  if ! snapshot=$(read_release_image_set "$current_file"); then
    image_cleanup_enabled=false
    log 'existing release record is invalid; skipping image cleanup for this deployment'
    return 0
  fi
  readarray -t previous_release_images <<<"$snapshot"
  if [[ "${#previous_release_images[@]}" -ne 4 ]]; then
    image_cleanup_enabled=false
    previous_release_images=()
    log 'existing release record is incomplete; skipping image cleanup for this deployment'
  fi
}

is_managed_release_image() {
  local image="$1"
  [[ "$image" =~ $api_pattern || "$image" =~ $migrate_pattern || "$image" =~ $worker_pattern || "$image" =~ $web_edge_pattern ]]
}

list_managed_release_images() {
  local rows repository image_id repo_digests image

  rows=$(docker image ls --no-trunc --format '{{.Repository}} {{.ID}}') || return 1
  while IFS=' ' read -r repository image_id; do
    [[ -n "$repository" && -n "$image_id" ]] || continue
    repository="${repository#docker.io/}"
    case "$repository" in
      "${dockerhub_namespace}/mrolescope-api"|"${dockerhub_namespace}/mrolescope-migrate"|"${dockerhub_namespace}/mrolescope-worker"|"${dockerhub_namespace}/mrolescope-web-edge")
        ;;
      *)
        continue
        ;;
    esac
    repo_digests=$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$image_id") || return 1
    while IFS= read -r image; do
      [[ -n "$image" ]] || continue
      image="docker.io/${image#docker.io/}"
      is_managed_release_image "$image" || continue
      printf '%s\n' "$image"
    done <<<"$repo_digests"
  done <<<"$rows"
}

image_is_container_referenced() {
  local image="$1" image_id container_ids container_id container_image_id

  if ! image_id=$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null); then
    return 0
  fi
  if ! container_ids=$(docker container ls -aq 2>/dev/null); then
    return 0
  fi
  while IFS= read -r container_id; do
    [[ -n "$container_id" ]] || continue
    if ! container_image_id=$(docker container inspect --format '{{.Image}}' "$container_id" 2>/dev/null); then
      return 0
    fi
    [[ "$container_image_id" == "$image_id" ]] && return 0
  done <<<"$container_ids"
  return 1
}

cleanup_stale_release_images() {
  local available_images image
  local -a candidates=()
  local -A retained_images=()

  [[ "$image_cleanup_enabled" == true ]] || return 0
  for image in "$api_image" "$migrate_image" "$worker_image" "$web_edge_image" "${previous_release_images[@]}"; do
    retained_images["$image"]=true
  done
  if ! available_images=$(list_managed_release_images); then
    log 'could not list local release images; cleanup incomplete'
    return 0
  fi
  readarray -t candidates <<<"$available_images"
  for image in "${candidates[@]}"; do
    [[ -n "$image" ]] || continue
    if [[ -n "${retained_images[$image]:-}" ]]; then
      continue
    fi
    if image_is_container_referenced "$image"; then
      log "retaining container-referenced image ${image}"
      continue
    fi
    if docker image rm "$image" >/dev/null; then
      log "removed stale release image ${image}"
    else
      log "could not remove stale release image ${image}; cleanup incomplete"
    fi
  done
}

healthy_api() {
  local attempt container_id status
  for ((attempt = 1; attempt <= 20; attempt += 1)); do
    container_id=$(compose ps -q api)
    status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$container_id" 2>/dev/null || true)
    if [[ "$status" == healthy ]]; then
      return 0
    fi
    sleep 2
  done
  return 1
}

healthy_web_edge() {
  local attempt status
  for ((attempt = 1; attempt <= 20; attempt += 1)); do
    status=$(curl --insecure --silent --output /dev/null --write-out '%{http_code}' \
      --max-time 3 --resolve "${MROLESCOPE_WEB_HOSTNAME}:443:127.0.0.1" \
      "https://${MROLESCOPE_WEB_HOSTNAME}/" 2>/dev/null || true)
    if [[ "$status" == 401 ]]; then
      return 0
    fi
    sleep 2
  done
  return 1
}

rollback_api() {
  local previous_api="$1"
  [[ -n "$previous_api" && "$previous_api" != "$api_image" ]] || return 1

  log "new API did not become healthy; restoring the previous verified API digest"
  export MROLESCOPE_API_IMAGE="$previous_api"
  compose up -d --no-deps api
  healthy_api
}

rollback_web_edge() {
  local previous_web_edge="$1"
  [[ -n "$previous_web_edge" && "$previous_web_edge" != "$web_edge_image" ]] || return 1

  log "new Web Edge did not become authentication-ready; restoring the previous verified Web Edge digest"
  export MROLESCOPE_WEB_EDGE_IMAGE="$previous_web_edge"
  compose --profile web up -d --no-deps web-edge
  healthy_web_edge
}

cleanup() {
  local exit_code=$?
  trap - EXIT
  if [[ "$deployment_succeeded" != true && "$deployment_config_loaded" == true && "$api_image" =~ $api_pattern && "$migrate_image" =~ $migrate_pattern && "$worker_image" =~ $worker_pattern && "$web_edge_image" =~ $web_edge_pattern && -d "$RELEASE_DIR" ]]; then
    write_record failed "$phase" "$api_image" "$migrate_image" "$worker_image" "$web_edge_image" "$api_revision" || true
    prune_records || true
  fi
  exit "$exit_code"
}
trap cleanup EXIT

[[ "${EUID}" -eq 0 ]] || die "must be invoked through sudo"
if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "mrolescope-deploy" ]]; then
  die "only the mrolescope-deploy service account may invoke this through sudo"
fi
[[ "$#" -eq 4 ]] || die "expected API, migration, worker, and Web Edge image digests"
is_root_owned_mode "$COMPOSE_FILE" 644 || die "Compose definition must be root:root mode 0644"
is_root_owned_mode "$SECRETS_FILE" 600 || die "runtime secrets must be root:root mode 0600"
load_deployment_config
[[ "$api_image" =~ $api_pattern ]] || die "API image is not an allowed immutable Docker Hub digest"
[[ "$migrate_image" =~ $migrate_pattern ]] || die "migration image is not an allowed immutable Docker Hub digest"
[[ "$worker_image" =~ $worker_pattern ]] || die "worker image is not an allowed immutable Docker Hub digest"
[[ "$web_edge_image" =~ $web_edge_pattern ]] || die "Web Edge image is not an allowed immutable Docker Hub digest"
[[ -d "$RELEASE_DIR" ]] || die "release directory is missing"
[[ "$(stat -c '%U:%G:%a' "$RELEASE_DIR")" == 'root:root:700' ]] || die "release directory must be root:root mode 0700"
command -v docker >/dev/null 2>&1 || die "docker is not installed"
command -v curl >/dev/null 2>&1 || die "curl is not installed"
command -v flock >/dev/null 2>&1 || die "flock is not installed"
exec 9>"$LOCK_FILE"
flock -n 9 || die "another deployment is already running"
capture_previous_release_images

# The root-owned file is a deliberately simple dotenv file. It is sourced only
# after ownership and mode checks so Compose and the validation below use one
# identical set of values. No value is ever printed.
set -a
# shellcheck disable=SC1090
. "$SECRETS_FILE"
set +a
for required_value in POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD DATABASE_URL; do
  [[ -n "${!required_value:-}" ]] || die "required runtime configuration is missing"
done

case "${MROLESCOPE_WEB_EDGE_ENABLED:-false}" in
  false)
    ;;
  true)
    web_edge_enabled=true
    for required_value in MROLESCOPE_WEB_HOSTNAME MROLESCOPE_WEB_AUTH_BCRYPT_HASH; do
      [[ -n "${!required_value:-}" ]] || die "required Web Edge runtime configuration is missing"
    done
    ;;
  *)
    die 'MROLESCOPE_WEB_EDGE_ENABLED must be true or false'
    ;;
esac

export MROLESCOPE_API_IMAGE="$api_image"
export MROLESCOPE_MIGRATE_IMAGE="$migrate_image"
export MROLESCOPE_WORKER_IMAGE="$worker_image"
export MROLESCOPE_WEB_EDGE_IMAGE="$web_edge_image"

phase="pull-images"
compose --profile web pull postgres migrate api worker web-edge
api_revision=$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$api_image" 2>/dev/null || true)
[[ "$api_revision" =~ $SHA_PATTERN ]] || die "API image is missing its immutable source revision label"
migrate_revision=$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$migrate_image" 2>/dev/null || true)
[[ "$migrate_revision" == "$api_revision" ]] || die "API and migration images were not built from the same revision"
worker_revision=$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$worker_image" 2>/dev/null || true)
[[ "$worker_revision" == "$api_revision" ]] || die "API, migration, and worker images were not built from the same revision"
web_edge_revision=$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$web_edge_image" 2>/dev/null || true)
[[ "$web_edge_revision" == "$api_revision" ]] || die "API, migration, worker, and Web Edge images were not built from the same revision"

previous_api=$(read_current_api || true)
previous_web_edge=$(read_current_web_edge || true)

phase="start-database"
compose up -d --wait --wait-timeout 60 postgres

phase="migrate-database"
recover_known_dirty_migration
compose run --rm migrate

phase="start-api"
if ! compose up -d --no-deps api; then
  rollback_api "$previous_api" || true
  die "could not start the new API container"
fi

phase="verify-api"
if ! healthy_api; then
  rollback_api "$previous_api" || true
  die "the new API did not pass local health and readiness checks"
fi

if [[ "$web_edge_enabled" == true ]]; then
  phase="start-web-edge"
  if ! compose --profile web up -d --no-deps web-edge; then
    rollback_web_edge "$previous_web_edge" || true
    die 'could not start the new Web Edge container'
  fi

  phase="verify-web-edge"
  if ! healthy_web_edge; then
    rollback_web_edge "$previous_web_edge" || true
    die 'the new Web Edge did not pass its local authentication boundary check'
  fi
else
  # A missing/false manual gate is fail-closed: retain API and scheduled work
  # but ensure a previously created public Web Edge is not left running.
  compose --profile web stop web-edge >/dev/null 2>&1 || true
fi

phase="record-release"
write_current
write_record success "$phase" "$api_image" "$migrate_image" "$worker_image" "$web_edge_image" "$api_revision"
prune_records
deployment_succeeded=true
phase="prune-images"
cleanup_stale_release_images
phase="complete"
log "deployment verified at revision ${api_revision}"
