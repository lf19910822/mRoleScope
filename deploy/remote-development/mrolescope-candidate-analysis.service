[Unit]
Description=mRoleScope v0.1 candidate JD technology analysis
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mrolescope-analysis candidate-v0.1
TimeoutStartSec=45m
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
